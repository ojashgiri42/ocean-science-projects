# pkg/diagnostics output for the project 15 spin-up.
# Times are in seconds. One model year = 31104000 s (360 days).
# frequency > 0 means "write the average over this period".
 &DIAGNOSTICS_LIST
# 1. Annual-mean meridional velocity, full 3D: needed for the AMOC every year
  fields(1,1) = 'VVEL    ',
  fileName(1) = 'vvel_annual',
  frequency(1) = 31104000.,
# 2. Annual-mean surface fluxes (2D): salinity and temperature restoring,
#    total salt flux, net freshwater flux
  fields(1:4,2) = 'SRELAX  ','TRELAX  ','SFLUX   ','oceFWflx',
  fileName(2) = 'surf_flux_annual',
  frequency(2) = 31104000.,
# 3. Annual-mean surface temperature and salinity (top level only)
  fields(1:2,3) = 'THETA   ','SALT    ',
  levels(1,3) = 1.,
  fileName(3) = 'surf_ts_annual',
  frequency(3) = 31104000.,
# 4. 10-year means of the full 3D state.
#    (GM_PsiY was tried in the 2-year test but is only filled when GM_AdvForm
#    is used; this tutorial uses the skew-flux form, so it stayed zero.)
  fields(1:3,4) = 'THETA   ','SALT    ','VVEL    ',
  fileName(4) = 'state_decadal',
  frequency(4) = 311040000.,
# 5. Monthly climatology of salinity restoring, averaged over each 100 years:
#    12 monthly means per file (needed for mixed boundary conditions in step 5)
  fields(1,5) = 'SRELAX  ',
  fileName(5) = 'srelax_clim100',
  frequency(5) = 3110400000.,
  averagingFreq(5) = 2592000.,
  repeatCycle(5) = 12,
 &

# Global statistics written as text: volume-mean T and S at every level, every year
 &DIAG_STATIS_PARMS
  stat_fields(1:2,1) = 'THETA   ','SALT    ',
  stat_fName(1) = 'ts_global_stats',
  stat_freq(1) = 31104000.,
 &
