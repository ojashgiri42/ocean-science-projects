# Restoring zone for project 16, step 4, case open_g05: the same as open_p10 (far field -0.9 degC),
# the reference case for step 4, because open_p10 reached a steady melt rate in step 3.
# Tendency added: -mask x (field - target) / tau, only where the mask is non-zero:
# the open-ocean zone north of the ice front at 71S.
 &RBCS_PARM01
 useRBCtemp=.TRUE.,
 useRBCsalt=.TRUE.,
# restoring time scale at full mask strength: 1 day (in seconds)
 tauRelaxT=86400.,
 tauRelaxS=86400.,
# mask 1 is used for temperature, mask 2 for salinity; both must be set
 relaxMaskFile(1)='rbcs_mask_open.bin',
 relaxMaskFile(2)='rbcs_mask_open.bin',
# targets: far-field temperature -0.9 degC and salinity 34.4 g/kg everywhere
 relaxTFile='theta_rbcs_p10.bin',
 relaxSFile='salt_34p4.bin',
 &
 &RBCS_PARM02
 &
